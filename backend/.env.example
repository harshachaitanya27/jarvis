# Jarvis backend — infrastructure config
# Copy to .env and fill in. Never commit .env.
# Vendor choices are values here, not imports in code — swap by changing a line.

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=text               # text (dev) | json (production aggregation)

# ── Observability (OpenTelemetry) ─────────────────────────────────
OTEL_ENABLED=false            # true to export logs, traces, and metrics
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # OTLP/HTTP collector base
OTEL_CONSOLE_EXPORT=false     # true to print signals to stdout (no collector)
SERVICE_NAME=jarvis-backend
SERVICE_VERSION=0.1.0

# ── Database (any Postgres — Supabase, RDS, local, Neon…) ──────────
# The code speaks SQLAlchemy + a URL, never a vendor SDK. Swap host by URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jarvis

# ── Object storage for generated audio ────────────────────────────
# Selects which StorageProvider adapter loads. local | s3 | supabase
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./media
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT=          # set for S3-compatible (R2, MinIO, Supabase S3)
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# ── Auth ──────────────────────────────────────────────────────────
# Selects which AuthProvider adapter loads. local | supabase | jwt
AUTH_PROVIDER=local

# ── Secrets ───────────────────────────────────────────────────────
# Fernet key used to encrypt each user's BYO provider API keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_KEY=

# JWT signing secret for access tokens (any long random string)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=10080

# ── Generation defaults (per-user config can override) ────────────
DEFAULT_LLM_PROVIDER=openai       # openai | anthropic | gemini
DEFAULT_TTS_PROVIDER=openai       # openai | elevenlabs
DEFAULT_EPISODE_MINUTES=10
DEFAULT_EPISODES_PER_NIGHT=3
